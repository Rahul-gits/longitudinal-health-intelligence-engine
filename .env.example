# ==============================================================================
# HEAL ENGINE — Environment Configuration Template (.env.example)
# Safe template containing variable definitions and safe placeholders only.
# NEVER commit real credentials, private keys, API keys, or database secrets.
# ==============================================================================

# Core Application Settings
PORT=5000
NODE_ENV=development
VITE_API_URL=http://localhost:5000
APP_BASE_URL=http://localhost:5000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000,http://127.0.0.1:3000

# Clinical LLM Gateway & Multi-Agent Inference
# Providers: GEMINI | OPENAI | ANTHROPIC
LLM_PROVIDER=GEMINI
LLM_MODEL=gemini-1.5-flash
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Vector Database (Qdrant)
VECTOR_DB_PROVIDER=qdrant
VECTOR_DB_HOST=localhost
VECTOR_DB_PORT=6333
VECTOR_DB_API_KEY=

# Distributed Cache & Queue (Redis + BullMQ)
REDIS_URL=redis://localhost:6379/0

# Database Persistence (PostgreSQL 16)
DATABASE_URL=postgres://heal_user:CHANGE_ME_PASSWORD@localhost:5432/heal_engine_db
DATABASE_SSL_MODE=prefer

# Authentication & Session Security
JWT_SECRET=CHANGE_ME_64_CHAR_HEX_RANDOM_SECRET_KEY
SESSION_MAX_AGE_SECONDS=3600
ENFORCE_PRIVILEGED_MFA=true

# Security Alerting & Inbound Webhooks
SECURITY_ALERT_WEBHOOK_URL=
INBOUND_WEBHOOK_SECRET=CHANGE_ME_HMAC_SECRET

# Clinical Document Vault & Object Storage
OBJECT_STORAGE_PROVIDER=local
OBJECT_STORAGE_BUCKET=heal-engine-encrypted-clinical-docs
OBJECT_STORAGE_REGION=us-east-1
KMS_KEY_ARN=arn:aws:kms:us-east-1:123456789012:key/heal-audit-worm-key
