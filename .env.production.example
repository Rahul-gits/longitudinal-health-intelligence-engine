# ==============================================================================
# Heal Engine: Production Environment & Secrets Configuration Template
# ==============================================================================

# Core Application
NODE_ENV=production
PORT=5000
APP_BASE_URL=https://healengine.hospital.org
CORS_ALLOWED_ORIGINS=https://healengine.hospital.org,https://mychart.hospital.org

# Database & Telemetry (PostgreSQL 16 + TimescaleDB)
DATABASE_URL=postgres://heal_user:CHANGE_ME_SECURE_PASSWORD@localhost:5432/heal_engine_db
DATABASE_POOL_MIN=4
DATABASE_POOL_MAX=20
DATABASE_SSL_MODE=require
DATABASE_SSL_CA=/etc/ssl/certs/rds-combined-ca-bundle.pem

# Asynchronous Distributed Queue (Redis + BullMQ)
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@localhost:6379/0
REDIS_MAX_RETRIES=3

# Guideline Vector Database (Qdrant / Milvus)
VECTOR_DB_PROVIDER=qdrant
VECTOR_DB_HOST=localhost
VECTOR_DB_PORT=6333
VECTOR_DB_API_KEY=CHANGE_ME_VECTOR_KEY

# Security, PKI & Audit Ledger
JWT_SECRET=CHANGE_ME_64_CHAR_HEX_RANDOM_SECRET_KEY
SESSION_MAX_AGE_SECONDS=3600
KMS_PROVIDER=aws_kms
KMS_KEY_ARN=arn:aws:kms:us-east-1:123456789012:key/heal-audit-worm-key
AUDIT_WORM_SALT=CHANGE_ME_IMMUTABLE_HASH_CHAIN_SALT

# SMART on FHIR / EHR Integration
FHIR_BASE_URL=https://fhir.epic.hospital.org/interconnect-fhir-oauth/api/FHIR/R4
SMART_CLIENT_ID=heal-engine-cdss-client-id
SMART_TOKEN_ENDPOINT=https://fhir.epic.hospital.org/interconnect-fhir-oauth/oauth2/token
SMART_AUTHORIZE_ENDPOINT=https://fhir.epic.hospital.org/interconnect-fhir-oauth/oauth2/authorize
CDS_HOOKS_ENDPOINT=https://healengine.hospital.org/api/workflow/cds-services

# Object Storage for Clinical Scans & PDF Reports (S3 / GCS / Azure Blob)
OBJECT_STORAGE_PROVIDER=s3
OBJECT_STORAGE_BUCKET=heal-engine-encrypted-clinical-docs
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_KMS_KEY=arn:aws:kms:us-east-1:123456789012:key/s3-server-side-encrypt

# Observability & Tracing
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
LOG_LEVEL=info
ENABLE_DETAILED_AUDIT_LOGGING=true
