      "eGFR < 60",
      "Renal Impairment",
      "Hyperkalemia"
    ],
    "recommendedAlternatives": [
      "Topical Diclofenac 1% gel",
      "Acetaminophen max 2g/day",
      "Physical therapy",
      "Heat/Cryotherapy"
    ],
